{
  "id": "match_binding_001",
  "question": "`match` で `value @ pattern` を使う目的として適切なのはどれですか？",
  "choices": [
    {
      "id": "a",
      "text": "一致した値を束縛しつつパターン判定する"
    },
    {
      "id": "b",
      "text": "パターン一致を無効化する"
    },
    {
      "id": "c",
      "text": "型推論を停止する"
    },
    {
      "id": "d",
      "text": "所有権を複製する"
    }
  ],
  "correctChoiceId": "a",
  "explanation": "`@` はパターン一致と値束縛を同時に行います。",
