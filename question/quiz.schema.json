{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/question/quiz.schema.json",
  "title": "Rust言語検定 クイズデータセット",
  "type": "array",
  "items": {
    "$ref": "#/$defs/quizItem"
  },
  "$defs": {
    "quizItem": {
      "type": "object",
      "required": [
        "id",
        "question",
        "choices",
        "correctChoiceId",
        "sources",
        "difficulty"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "correctChoiceId": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "difficulty": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
